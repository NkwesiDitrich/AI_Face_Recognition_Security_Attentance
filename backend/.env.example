# ============================================
# AI Face Attendance - Backend Environment
# ============================================
# Copy to .env and fill in your values.
# For production: use MongoDB Atlas, set CORS_ORIGINS.

# ---- MongoDB ----
# Local: mongodb://localhost:27017/face_attendance_db
# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/face_attendance_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/face_attendance_db
DATABASE_NAME=face_attendance_db

# ---- CORS (production only) ----
# Comma-separated allowed origins, e.g.:
# https://admin-your-app.vercel.app,https://user-your-app.vercel.app
# Leave empty for localhost defaults.
CORS_ORIGINS=
